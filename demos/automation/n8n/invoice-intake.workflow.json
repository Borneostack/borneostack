        }
      }
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "attachment_0",
        "options": {}
      },
      "id": "read-the-pdf",
      "name": "Read the PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.text }}",
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"supplier\":{\"type\":[\"string\",\"null\"]},\"invoice_number\":{\"type\":[\"string\",\"null\"]},\"invoice_date\":{\"type\":[\"string\",\"null\"],\"description\":\"YYYY-MM-DD\"},\"due_date\":{\"type\":[\"string\",\"null\"],\"description\":\"YYYY-MM-DD, null if not printed\"},\"currency\":{\"type\":[\"string\",\"null\"],\"description\":\"ISO code, RM is MYR\"},\"payment_terms\":{\"type\":[\"string\",\"null\"]},\"lines\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"description\":{\"type\":\"string\"},\"quantity\":{\"type\":\"number\"},\"unit_price\":{\"type\":\"number\"},\"amount\":{\"type\":\"number\"}}}},\"subtotal\":{\"type\":[\"number\",\"null\"]},\"tax\":{\"type\":[\"number\",\"null\"]},\"total\":{\"type\":[\"number\",\"null\"]}}}",
        "options": {
          "systemPromptTemplate": "Copy the fields printed on the invoice. Use null for anything not printed. Never calculate or guess. Dates are YYYY-MM-DD; dates in Malaysia are day/month/year. RM means MYR."
        }
      },
      "id": "extract-the-fields",
      "name": "Extract the fields",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0
        }
      },
      "id": "gemini-chat-model",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        480,
        520
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SPREADSHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Ledger"
        },
        "options": {}
      },
      "id": "read-ledger",
      "name": "Read ledger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        720,
        300
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Checks run here, in plain code, not in the model.\nconst x = $input.first().json.output ?? $input.first().json\nconst ledger = $('Read ledger').all().map(i => i.json)\nconst cents = n => Math.round(Number(n) * 100)\nconst near = (a, b) => Math.abs(cents(a) - cents(b)) <= 1\nconst rm = n => `RM ${Number(n).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`\nconst reasons = []\nconst lines = Array.isArray(x.lines) ? x.lines : []\nconst missing = ['supplier', 'invoice_number', 'invoice_date', 'total'].filter(k => x[k] === null || x[k] === undefined || x[k] === '')\nif (missing.length) reasons.push(`Missing from the invoice: ${missing.join(', ')}.`)\nif (!x.due_date) reasons.push('The invoice has no due date, so the system cannot say when it is late.')\nif (x.currency && x.currency !== 'MYR') reasons.push(`The invoice is in ${x.currency}, not Ringgit.`)\nconst sum = lines.reduce((n, l) => n + Number(l.amount || 0), 0)\nconst base = x.subtotal ?? (x.total != null ? x.total - (x.tax ?? 0) : null)\nif (lines.length && base != null && !near(sum, base)) reasons.push(`The lines add up to ${rm(sum)} but the invoice says ${rm(base)}.`)\nif (x.subtotal != null && x.total != null && !near(x.subtotal + (x.tax ?? 0), x.total)) reasons.push('Subtotal plus tax does not equal the total.')\nconst key = s => String(s ?? '').toLowerCase().replace(/[^a-z0-9]/g, '')\nconst duplicate = ledger.some(r => key(r.supplier) === key(x.supplier) && key(r.invoice_number) === key(x.invoice_number) && key(x.invoice_number))\nif (duplicate) reasons.push('This supplier and invoice number are already in the ledger.')\nconst today = new Date(Date.now() + 8 * 3600e3).toISOString().slice(0, 10)\nconst days = x.due_date ? Math.floor((Date.parse(x.due_date) - Date.parse(today)) / 86400e3) : null\nconst due_status = days === null ? 'unknown' : days < 0 ? 'overdue' : days <= 7 ? 'due_soon' : 'later'\nconst needs_review = reasons.length > 0\nconst who = `${x.supplier ?? 'Unknown supplier'}, ${x.invoice_number ?? 'no number'}`\nconst alert = needs_review\n  ? `Invoice needs a person.\\n${who}, ${x.total != null ? rm(x.total) : 'amount not read'}.\\n${reasons.map(r => `- ${r}`).join('\\n')}`\n  : `${due_status === 'overdue' ? 'Overdue invoice filed.' : 'Invoice filed.'}\\n${who}.\\n${rm(x.total)}, due ${x.due_date}.`\nreturn [{ json: { ...x, reasons: reasons.join(' | '), due_status, needs_review, duplicate, alert, filed_at: new Date().toISOString() } }]\n"
      },
      "id": "checks-and-duplicate",
      "name": "Checks and duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "review",
              "leftValue": "={{ $json.needs_review }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "needs-review-",
      "name": "Needs review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        300
      ]
    },
